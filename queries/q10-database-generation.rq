# Q10 How was the search database generated?
PREFIX codhmo: <https://codicum.eu/ontology/codhmo#>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crmsci: <http://www.cidoc-crm.org/extensions/crmsci/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?database ?generation ?software ?version ?configuredState WHERE {
  ?search a codhmo:DatabaseSearch ; prov:used ?database .
  ?database a codhmo:SearchDatabase ; prov:wasGeneratedBy ?generation .
  ?generation prov:wasAssociatedWith ?software ; prov:used ?config .
  ?software dcterms:hasVersion ?version .
  ?config a codhmo:GenerationConfiguration ; codhmo:configuredMaterialState ?configuredState .
}
