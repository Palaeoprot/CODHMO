# CODHMO — CODICUM Heritage Material Ontology, core module
# v0.1 draft, 2026-09-17. Source of truth for OWL/JSON-LD derivations.
# Targets CIDOC CRM 7.1.3, CRMsci 3.2 and CRMinf 1.2.1 (IRIs verified against cidoc-crm.org RDFS, 2026-09-17).
# See alignment/codhmo-matrix.csv for the term-by-term reuse decisions.

@prefix codhmo: <https://codicum.eu/ontology/codhmo#> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/extensions/crminf/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:   <http://purl.org/vocab/vann/> .

<https://codicum.eu/ontology/codhmo>
    a owl:Ontology ;
    skos:scopeNote "CODHMO properties carry no rdfs:domain/rdfs:range: under RDFS inference those silently retype misused subjects/objects. Intended subjects/objects are stated in definitions and enforced by SHACL (D10, D22)."@en ;
    dcterms:title "CODICUM Heritage Material Ontology (CODHMO) — Core"@en ;
    dcterms:description "Thin domain layer linking heritage objects, material layers, samples, analyses, evidence and competing hypotheses. Reuses CIDOC CRM, CRMsci, CRMinf and PROV-O; defines only what they lack."@en ;
    owl:versionInfo "0.1-draft" ;
    owl:versionIRI <https://codicum.eu/ontology/codhmo/0.1> ;
    vann:preferredNamespacePrefix "codhmo" ;
    vann:preferredNamespaceUri "https://codicum.eu/ontology/codhmo#" ;
    dcterms:created "2026-09-17"^^xsd:date ;
    rdfs:comment "Namespace is provisional. External ontologies are referenced, not owl:imported, until versions are pinned."@en .

#################################################################
# Heritage layer
#################################################################

codhmo:HeritageObject a owl:Class ;
    rdfs:label "heritage object"@en ;
    skos:definition "A physical cultural-heritage object to which material analysis refers. Codicological kinds (manuscript, charter, leaf, binding) are expressed with crm:P2_has_type, not subclasses."@en ;
    rdfs:subClassOf crm:E22_Human-Made_Object ;
    skos:example "Pepys MS 2981" .

codhmo:Fragment a owl:Class ;
    rdfs:label "fragment"@en ;
    skos:definition "A detached part of a former heritage object, now a component of another object. Linked to its current host with crm:P46_is_composed_of."@en ;
    rdfs:subClassOf codhmo:HeritageObject ;
    skos:example "Fragment 4, page 5, Pepys MS 2981" .

codhmo:MaterialLayer a owl:Class ;
    rdfs:label "material layer"@en ;
    skos:definition "A spatially bounded body of material on or in a heritage object, such as an adhesive, coating, ink, sizing or repair. Attached to its object with crm:P46_is_composed_of; its material kind is given with crm:P45_consists_of."@en ;
    rdfs:subClassOf crmsci:S10_Material_Substantial ;
    skos:example "Adhesive layer beneath fragment 4" .

#################################################################
# Computational analysis layer (PROV-O aligned)
#################################################################

codhmo:DatabaseGeneration a owl:Class ;
    rdfs:label "database generation"@en ;
    skos:definition "A computational activity that generates a search database from source sequences under a recorded configuration."@en ;
    rdfs:subClassOf prov:Activity ;
    skos:example "seqdb-gen (Rust) run producing a sequence search database" .

codhmo:DatabaseSearch a owl:Class ;
    rdfs:label "database search"@en ;
    skos:definition "A computational activity that matches measured spectra against a search database."@en ;
    rdfs:subClassOf prov:Activity .

codhmo:SearchDatabase a owl:Class ;
    rdfs:label "search database"@en ;
    skos:definition "A generated sequence database used for spectral search."@en ;
    rdfs:subClassOf prov:Entity .

codhmo:GenerationConfiguration a owl:Class ;
    rdfs:label "generation configuration"@en ;
    skos:definition "The configuration used by a database generation. A configured material state (e.g. denatured collagen) is a statement about the computation, never about the sample."@en ;
    rdfs:subClassOf prov:Entity .

codhmo:PeptideIdentification a owl:Class ;
    rdfs:label "peptide identification"@en ;
    skos:definition "A peptide-level result of a database search. It is an observation, not a taxonomic or material identification."@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "Align with PSI-MS / mzIdentML before adding properties."@en .

codhmo:PTMObservation a owl:Class ;
    rdfs:label "PTM observation"@en ;
    skos:definition "An observed post-translational or diagenetic modification at a residue position. It carries no chronological interpretation."@en ;
    rdfs:subClassOf prov:Entity .

#################################################################
# Interpretation layer (CRMinf aligned)
#################################################################

codhmo:MaterialHypothesis a owl:Class ;
    rdfs:label "material hypothesis"@en ;
    skos:definition "A belief about the identity or composition of a material. Its proposition is given with crminf:J4_that; its confidence with crminf:J5_holds_to_be."@en ;
    rdfs:subClassOf crminf:I2_Belief .

codhmo:TaxonomicHypothesis a owl:Class ;
    rdfs:label "taxonomic hypothesis"@en ;
    skos:definition "A material hypothesis about the biological source of a material, at an explicitly stated taxonomic rank."@en ;
    rdfs:subClassOf codhmo:MaterialHypothesis .

codhmo:ManufacturingHypothesis a owl:Class ;
    rdfs:label "manufacturing hypothesis"@en ;
    skos:definition "A material hypothesis about the process or formulation that produced a material."@en ;
    rdfs:subClassOf codhmo:MaterialHypothesis .

codhmo:HistoricalInterpretation a owl:Class ;
    rdfs:label "historical interpretation"@en ;
    skos:definition "A belief about when, by whom or why a material came to be part of a heritage object. Independent of any material hypothesis."@en ;
    rdfs:subClassOf crminf:I2_Belief ;
    owl:disjointWith codhmo:MaterialHypothesis .

#################################################################
# Object properties defined by CODHMO
#################################################################

codhmo:hasComponentMaterial a owl:ObjectProperty ;
    rdfs:label "has component material"@en ;
    skos:definition "Relates a material body to a constituent material body in a formulation (e.g. glue to its starch component). Composition is an interpretation, so it is asserted only inside a proposition."@en ;
    skos:scopeNote "Formulation modelling is provisional (handover §17)."@en .

codhmo:hasBiologicalSource a owl:ObjectProperty ;
    rdfs:label "has biological source"@en ;
    skos:definition "Relates a material body to an NCBI Taxonomy node, given as the numeric-ID IRI http://purl.obolibrary.org/obo/NCBITaxon_<taxid>. Asserted only inside the proposition of a hypothesis, never as a direct fact about a sample."@en ;
    skos:scopeNote "Numeric NCBI taxids are the only identifier. Genus/species names are labels, never keys: names are revised, the numeric node (and its higher-rank ancestors) is stable. State the rank the evidence supports; do not promote a family taxid to a genus or species."@en .

codhmo:hasSourceTissue a owl:ObjectProperty ;
    rdfs:label "has source tissue"@en ;
    skos:definition "Relates a material body to an anatomical source, given as an external IRI (e.g. UBERON)."@en .

codhmo:hasMaterialState a owl:ObjectProperty ;
    rdfs:label "has material state"@en ;
    skos:definition "Relates a material body to its physical or chemical state, drawn from the codhmo material-state scheme."@en .

codhmo:configuredMaterialState a owl:ObjectProperty ;
    rdfs:label "configured material state"@en ;
    skos:definition "Relates a generation configuration to the material state it models. Distinct from codhmo:hasMaterialState."@en .

codhmo:hasPTMObservation a owl:ObjectProperty ;
    rdfs:label "has PTM observation"@en .

codhmo:evidentialRelation a owl:ObjectProperty ;
    rdfs:label "evidential relation"@en ;
    skos:definition "Abstract parent of defeasible, non-entailing relations from an observation to a belief. None of its subproperties implies logical proof."@en ;
    skos:scopeNote "Object must be a crminf:I2_Belief. Enforced by SHACL, not rdfs:range, so a mistyped target is reported rather than silently inferred to be a belief."@en .

codhmo:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    skos:definition "The observation raises the plausibility of the belief."@en ;
    rdfs:subPropertyOf codhmo:evidentialRelation .

codhmo:contradicts a owl:ObjectProperty ;
    rdfs:label "contradicts"@en ;
    skos:definition "The observation lowers the plausibility of the belief."@en ;
    rdfs:subPropertyOf codhmo:evidentialRelation .

codhmo:compatibleWith a owl:ObjectProperty ;
    rdfs:label "compatible with"@en ;
    skos:definition "The observation is consistent with the belief but does not discriminate it from alternatives."@en ;
    rdfs:subPropertyOf codhmo:evidentialRelation .

codhmo:hasCompetingHypothesis a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:label "has competing hypothesis"@en ;
    skos:definition "Relates two beliefs that offer alternative answers to the same question. Neither is deleted when one appears stronger."@en .

#################################################################
# SKOS: material-state scheme
#################################################################

codhmo:MaterialStateScheme a skos:ConceptScheme ;
    skos:prefLabel "CODHMO material states"@en .

codhmo:Native a skos:Concept ;
    skos:inScheme codhmo:MaterialStateScheme ; skos:topConceptOf codhmo:MaterialStateScheme ;
    skos:prefLabel "native"@en .

codhmo:Denatured a skos:Concept ;
    skos:inScheme codhmo:MaterialStateScheme ; skos:topConceptOf codhmo:MaterialStateScheme ;
    skos:prefLabel "denatured"@en ;
    skos:definition "Tertiary/quaternary structure lost, e.g. collagen converted to gelatin/glue by heating."@en .

#################################################################
# SKOS: material scheme (seed; AAT matches to be added)
#################################################################

codhmo:MaterialScheme a skos:ConceptScheme ;
    skos:prefLabel "CODHMO heritage materials"@en ;
    skos:scopeNote "Each concept is also typed crm:E57_Material. Link to Getty AAT with skos:exactMatch/closeMatch."@en .

codhmo:adhesive a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ;
    skos:prefLabel "adhesive"@en .

codhmo:collagen-adhesive a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:broader codhmo:adhesive ;
    skos:prefLabel "collagen adhesive"@en ; skos:altLabel "animal glue"@en .

codhmo:rabbit-skin-glue a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:broader codhmo:collagen-adhesive ;
    skos:prefLabel "rabbit-skin glue"@en .

codhmo:isinglass a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:broader codhmo:collagen-adhesive ;
    skos:prefLabel "isinglass"@en ; skos:altLabel "fish glue"@en .

codhmo:starch-adhesive a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:broader codhmo:adhesive ;
    skos:prefLabel "starch adhesive"@en ; skos:altLabel "flour paste"@en .

codhmo:protein-binder a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ;
    skos:prefLabel "protein binder"@en .

codhmo:parchment a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ;
    skos:prefLabel "parchment"@en .

codhmo:paper a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ;
    skos:prefLabel "paper"@en .

codhmo:ink a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ;
    skos:prefLabel "ink"@en .

#################################################################
# Formulations: component roles (added Step 6)
#################################################################

codhmo:hasComponentRole a owl:ObjectProperty ;
    rdfs:label "has component role"@en ;
    skos:definition "Relates a constituent material body to the role it plays in a formulation, drawn from codhmo:ComponentRoleScheme. A role is an interpretation (the same protein can be binder, contaminant or evidence of use), so it is asserted only inside a proposition."@en .

codhmo:ComponentRoleScheme a skos:ConceptScheme ;
    skos:prefLabel "CODHMO formulation component roles"@en .

codhmo:role-bulk a skos:Concept ; skos:inScheme codhmo:ComponentRoleScheme ; skos:topConceptOf codhmo:ComponentRoleScheme ;
    skos:prefLabel "bulk / filler"@en .
codhmo:role-binder a skos:Concept ; skos:inScheme codhmo:ComponentRoleScheme ; skos:topConceptOf codhmo:ComponentRoleScheme ;
    skos:prefLabel "binder"@en .
codhmo:role-additive a skos:Concept ; skos:inScheme codhmo:ComponentRoleScheme ; skos:topConceptOf codhmo:ComponentRoleScheme ;
    skos:prefLabel "additive"@en .
codhmo:role-contaminant a skos:Concept ; skos:inScheme codhmo:ComponentRoleScheme ; skos:topConceptOf codhmo:ComponentRoleScheme ;
    skos:prefLabel "contaminant"@en ;
    skos:definition "Material present but not part of the historical formulation (e.g. human keratin, bacterial protein, lab trypsin)."@en .

codhmo:paste a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ;
    skos:prefLabel "paste"@en ;
    skos:scopeNote "Generic: ground mineral bound with organic medium; no heat treatment implied (Kasso et al.)."@en .
codhmo:calcite a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ; skos:prefLabel "calcite"@en .
codhmo:gypsum a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:topConceptOf codhmo:MaterialScheme ; skos:prefLabel "gypsum"@en .
codhmo:gilding-adhesive a skos:Concept, crm:E57_Material ;
    skos:inScheme codhmo:MaterialScheme ; skos:broader codhmo:adhesive ; skos:prefLabel "gold-leaf adhesive"@en .

#################################################################
# Domain inference rules (CRMinf I3_Inference_Logic)
#################################################################

codhmo:rule-parchment-bos-is-calf a crminf:I3_Inference_Logic ;
    rdfs:label "Bovine parchment is calfskin"@en ;
    skos:definition "If a PARCHMENT support has biological source Bos (NCBITaxon_9903 or a descendant), the skin came from a calf: workable parchment cannot be made from cattle skin older than about 8 weeks."@en ;
    skos:scopeNote "Applies to parchment only. It does NOT apply to Bos leather, glue or other collagen products, where adult hide is normal. Apply via crminf:I5_Inference_Making: crminf:J3_applied this rule, crminf:J1_used_as_premise the taxonomic belief, crminf:J2_concluded_that the calfskin belief."@en ;
    dcterms:source "Domain rule supplied by M. Collins, 2026-09-17."@en .

#################################################################
# Sensitivity (handling / ethics flags)
#################################################################

codhmo:hasSensitivity a owl:ObjectProperty ;
    rdfs:label "has sensitivity"@en ;
    skos:definition "Flags a material body, heritage object or belief as requiring special handling, display or publication care. A precautionary handling statement, not a scientific claim: it is asserted directly, and applies even when the triggering identification is only a hypothesis."@en .

codhmo:SensitivityScheme a skos:ConceptScheme ;
    skos:prefLabel "CODHMO sensitivity flags"@en .

codhmo:sensitivity-human-derived a skos:Concept ;
    skos:inScheme codhmo:SensitivityScheme ; skos:topConceptOf codhmo:SensitivityScheme ;
    skos:prefLabel "human-derived material"@en ;
    skos:definition "Material that is, or is hypothesised to be, derived from human remains (skin, bone, hair, tissue). Requires ethical review before sampling, imaging, display or data publication, and respectful description."@en ;
    skos:scopeNote "Triggered only by a biological-source proposition pointing to Homo sapiens (NCBITaxon_9606). Archaic hominins (Neanderthals, Denisovans) and genus-level Homo (9605) do not trigger it. Incidental modern human contamination (keratins, handling) is recorded as a contaminant role, not a biological source, and does not trigger the flag."@en .

#################################################################
# Source records: links to rows in external data stores (added Step 7)
#################################################################

codhmo:SourceRecord a owl:Class ;
    rdfs:label "source record"@en ;
    skos:definition "A pointer to one row of an external tabular data store (for example a ZoomzPeak spectrum table). Bulk data such as peak lists stays in the store; the graph holds only the locator."@en ;
    skos:scopeNote "Rows are located by the store's natural key columns until the store provides a stable content-addressed identifier. The store schema version is recorded so a locator can be migrated when key columns change (D23)."@en ;
    rdfs:subClassOf prov:Entity .

codhmo:hasSourceRecord a owl:ObjectProperty ;
    rdfs:label "has source record"@en ;
    skos:definition "Relates an observation (crmsci:S4_Single_Observation) or a peptide identification to the source record holding its underlying data."@en .

codhmo:inStore a owl:DatatypeProperty ;
    rdfs:label "in store"@en ;
    skos:definition "Names the data store holding a source record, e.g. \"ZoomzPeak\"."@en .

codhmo:inTable a owl:DatatypeProperty ;
    rdfs:label "in table"@en ;
    skos:definition "Names the table of the store holding a source record, e.g. \"ZOOMS_SPECTRA\"."@en .

codhmo:storeSchemaVersion a owl:DatatypeProperty ;
    rdfs:label "store schema version"@en ;
    skos:definition "The store's schema version at the time the locator was written."@en .

codhmo:hasKey a owl:ObjectProperty ;
    rdfs:label "has key"@en ;
    skos:definition "Relates a source record to one of the key column/value pairs that together locate its row."@en .

codhmo:keyName a owl:DatatypeProperty ;
    rdfs:label "key name"@en ;
    skos:definition "The column name of a source-record key."@en .

codhmo:keyValue a owl:DatatypeProperty ;
    rdfs:label "key value"@en ;
    skos:definition "The value of a source-record key column, as a string."@en .

#################################################################
# SKOS: taxonomic determinacy scheme
#################################################################

codhmo:DeterminacyScheme a skos:ConceptScheme ;
    skos:prefLabel "CODHMO taxonomic determinacy"@en ;
    skos:definition "How firmly the source holds a taxonomic attribution, in the source's own terms."@en ;
    skos:scopeNote "Carried on the belief node with crminf:J5_holds_to_be. CRMinf's own examples give J5 a truth-like I6_Belief_Value; CODHMO extends it to a domain scheme so that a published source's hedging survives verbatim instead of being flattened to true/false/unknown. Declared here so the extension is explicit rather than discovered."@en ;
    skos:scopeNote "Determinacy is a property of the attribution, NOT of any one observation. Do not derive it from codhmo:supports / codhmo:compatibleWith: a belief backed by two observations, one discriminating and one not, carries two edges of different strength but a single determinacy."@en .

codhmo:determined a skos:Concept ;
    skos:inScheme codhmo:DeterminacyScheme ; skos:topConceptOf codhmo:DeterminacyScheme ;
    skos:prefLabel "determined"@en ;
    skos:definition "The source states the taxon outright, at the rank it reports."@en .

codhmo:indistinguishable a skos:Concept ;
    skos:inScheme codhmo:DeterminacyScheme ; skos:topConceptOf codhmo:DeterminacyScheme ;
    skos:prefLabel "indistinguishable"@en ;
    skos:definition "The source names two or more taxa that its evidence cannot separate, e.g. the caprine call 'Capra hircus/Ovis aries'."@en ;
    skos:scopeNote "A positive claim about an irreducible set, not a failure to identify: it carries more weight than an undetermined attribution. The members are NOT competing hypotheses -- the source is not undecided between them, it reports that the method does not discriminate them. Where a shared parent node exists, recording that node at its own rank may express the same claim more directly."@en .

codhmo:alternatives-only a skos:Concept ;
    skos:inScheme codhmo:DeterminacyScheme ; skos:topConceptOf codhmo:DeterminacyScheme ;
    skos:prefLabel "alternatives only"@en ;
    skos:definition "The source offers a set of candidate taxa with none preferred."@en ;
    skos:scopeNote "Distinct from codhmo:compatible-only: there the source declines to determine but names what it is compatible with, whereas here no preferred taxon exists at all. Do not synthesise one by promoting the first member."@en .

codhmo:compatible-only a skos:Concept ;
    skos:inScheme codhmo:DeterminacyScheme ; skos:topConceptOf codhmo:DeterminacyScheme ;
    skos:prefLabel "compatible only"@en ;
    skos:definition "The source declines to determine the taxon but names one the evidence is compatible with."@en ;
    skos:scopeNote "The absence of any attribution is modelled by the ABSENCE of a codhmo:TaxonomicHypothesis, never by a concept in this scheme: a belief whose proposition has no object would assert a claim the source refused to make."@en .


#################################################################
# Document locators (citable positions in published sources)
#################################################################

codhmo:DocumentLocator a owl:Class ;
    rdfs:label "document locator"@en ;
    skos:definition "A citable position in a published document: the DOI, plus either a prose anchor (section and line) or a table reference with the key columns identifying one row."@en ;
    skos:scopeNote "Distinct from codhmo:SourceRecord, which locates a row in a MEASUREMENT store (ZoomzPeak) and is bound to that store's enumerated tables and schema version. A DocumentLocator cites published scholarship instead, so the two must not be conflated: widening SourceRecord to admit a paper's supplement would mix a bibliographic citation with instrument data."@en ;
    skos:scopeNote "A bare DOI is not a locator. Cite the position that carries the claim, so a reader can check it without re-reading the paper."@en .

codhmo:hasDocumentLocator a owl:ObjectProperty ;
    rdfs:label "has document locator"@en ;
    skos:definition "Relates an observation, a belief or a proposition to the position in a published document that states it."@en .

codhmo:atSection a owl:DatatypeProperty ;
    rdfs:label "at section"@en ;
    skos:definition "The section of the cited document, as the section identifier of the derived text (e.g. \"04_Animal_proteins\")."@en .

codhmo:atLine a owl:DatatypeProperty ;
    rdfs:label "at line"@en ;
    skos:definition "The line anchor within the cited section (e.g. \"L26\")."@en .

codhmo:atTable a owl:DatatypeProperty ;
    rdfs:label "at table"@en ;
    skos:definition "The supplementary table of the cited document, named as published or as filed. Identify the row itself with codhmo:hasKey."@en .
