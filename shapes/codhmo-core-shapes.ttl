# CODHMO v0.1 — SHACL shapes for the minimal conformance profile (handover §26, §30).
# sh:Violation = MUST, sh:Warning = SHOULD. Validate with the ontology as ont_graph and RDFS inference
# so that codhmo subclasses satisfy targets on CRM/CRMsci/CRMinf/PROV classes.

@prefix codhmo: <https://codicum.eu/ontology/codhmo#> .
@prefix shapes: <https://codicum.eu/ontology/codhmo/shapes#> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix crminf: <http://www.cidoc-crm.org/extensions/crminf/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# 1. Heritage object ------------------------------------------------------
shapes:HeritageObjectShape a sh:NodeShape ;
    sh:targetClass codhmo:HeritageObject ;
    sh:property [
        sh:path crm:P1_is_identified_by ; sh:minCount 1 ;
        sh:message "A heritage object MUST have an identifier (crm:P1)." ] .

# 2. Material layer -------------------------------------------------------
shapes:MaterialLayerShape a sh:NodeShape ;
    sh:targetClass codhmo:MaterialLayer ;
    sh:property [
        sh:path [ sh:inversePath crm:P46_is_composed_of ] ; sh:minCount 1 ;
        sh:class crm:E22_Human-Made_Object ;
        sh:message "A material layer MUST be part of a heritage object (inverse crm:P46)." ] ;
    sh:property [
        sh:path crm:P45_consists_of ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A material layer SHOULD state its material (crm:P45)." ] ;
    sh:property [
        sh:path crm:P45_consists_of ; sh:class crm:E57_Material ;
        sh:message "crm:P45 values MUST be crm:E57_Material concepts." ] .

# 3. Sampling event -------------------------------------------------------
shapes:SampleTakingShape a sh:NodeShape ;
    sh:targetClass crmsci:S2_Sample_Taking ;
    sh:property [
        sh:path crmsci:O5_removed ; sh:minCount 1 ; sh:class crmsci:S13_Sample ;
        sh:message "A sample taking MUST record the sample it removed (crmsci:O5)." ] ;
    sh:property [
        sh:path crmsci:O3_sampled_from ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A sample taking SHOULD record what it sampled from (crmsci:O3)." ] ;
    sh:property [
        sh:path crmsci:O4_sampled_at ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A sample taking SHOULD record where it sampled (crmsci:O4)." ] ;
    sh:property [
        sh:path crm:P14_carried_out_by ; sh:minCount 1 ;
        sh:or ( [ sh:class crm:E39_Actor ] [ sh:class crm:E21_Person ] [ sh:class crm:E74_Group ] ) ;
        sh:message "A sample taking MUST record who carried it out (crm:P14, an E39 Actor)." ] ;
    sh:property [
        sh:path crm:P4_has_time-span ; sh:minCount 1 ; sh:maxCount 1 ; sh:class crm:E52_Time-Span ;
        sh:message "A sample taking MUST record when it happened (crm:P4, one E52 Time-Span)." ] .

shapes:TimeSpanShape a sh:NodeShape ;
    sh:targetObjectsOf crm:P4_has_time-span ;
    sh:or ( [ sh:path crm:P82a_begin_of_the_begin ; sh:minCount 1 ]
            [ sh:path crm:P82b_end_of_the_end ; sh:minCount 1 ] ) ;
    sh:message "A time-span MUST give at least one bound (crm:P82a and/or crm:P82b). A literature-derived sampling may carry only 'on or before' (P82b)." ;
    sh:property [ sh:path crm:P82a_begin_of_the_begin ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "crm:P82a MUST be a single xsd:dateTime." ] ;
    sh:property [ sh:path crm:P82b_end_of_the_end ; sh:maxCount 1 ; sh:datatype xsd:dateTime ;
        sh:message "crm:P82b MUST be a single xsd:dateTime." ] .

# 4. Sample ---------------------------------------------------------------
shapes:SampleShape a sh:NodeShape ;
    sh:targetClass crmsci:S13_Sample ;
    sh:property [
        sh:path crm:P1_is_identified_by ; sh:minCount 1 ;
        sh:message "A sample MUST have an identifier (crm:P1)." ] ;
    sh:property [
        sh:path crmsci:O5i_was_removed_by ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A sample SHOULD link to its sampling activity (crmsci:O5i)." ] .

# 5–6. Material state: only from the codhmo state scheme -------------------
shapes:MaterialStateValueShape a sh:NodeShape ;
    sh:targetObjectsOf codhmo:hasMaterialState, codhmo:configuredMaterialState ;
    sh:property [
        sh:path skos:inScheme ; sh:hasValue codhmo:MaterialStateScheme ;
        sh:message "Material states MUST come from codhmo:MaterialStateScheme." ] .

# Rule 2 (§31): no direct taxon on a sample ------------------------------
shapes:NoTaxonOnSampleShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasBiologicalSource ;
    sh:not [ sh:class crmsci:S13_Sample ] ;
    sh:message "codhmo:hasBiologicalSource MUST NOT be asserted directly on a sample; state it inside a hypothesis proposition." .

# 7–8. Analytical activity and observation --------------------------------
shapes:DatabaseSearchShape a sh:NodeShape ;
    sh:targetClass codhmo:DatabaseSearch ;
    sh:property [
        sh:path prov:used ; sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [ sh:class codhmo:SearchDatabase ] ;
        sh:message "A database search MUST record the search database it used (prov:used)." ] .

shapes:PeptideIdentificationShape a sh:NodeShape ;
    sh:targetClass codhmo:PeptideIdentification ;
    sh:property [
        sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:class codhmo:DatabaseSearch ;
        sh:message "A peptide identification MUST trace to the database search that generated it." ] .

# 9. Evidence → hypothesis -------------------------------------------------
shapes:EvidentialTargetShape a sh:NodeShape ;
    sh:targetObjectsOf codhmo:supports, codhmo:contradicts, codhmo:compatibleWith ;
    sh:class crminf:I2_Belief ;
    sh:message "Evidential relations MUST point to a crminf:I2_Belief." .

shapes:BeliefShape a sh:NodeShape ;
    sh:targetClass codhmo:MaterialHypothesis, codhmo:HistoricalInterpretation ;
    sh:property [
        sh:path crminf:J4_that ; sh:minCount 1 ;
        sh:message "A hypothesis MUST have a proposition (crminf:J4_that)." ] ;
    sh:property [
        sh:path [ sh:inversePath [ sh:alternativePath ( codhmo:supports codhmo:contradicts codhmo:compatibleWith ) ] ] ;
        sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A hypothesis SHOULD have at least one evidential relation." ] .

# 10. Computational provenance --------------------------------------------
shapes:DatabaseGenerationShape a sh:NodeShape ;
    sh:targetClass codhmo:DatabaseGeneration ;
    sh:property [
        sh:path prov:wasAssociatedWith ; sh:minCount 1 ; sh:class prov:SoftwareAgent ;
        sh:message "A database generation MUST name the software that ran it." ] ;
    sh:property [
        sh:path prov:used ; sh:qualifiedMinCount 1 ;
        sh:qualifiedValueShape [ sh:class codhmo:GenerationConfiguration ] ;
        sh:message "A database generation MUST record its configuration (prov:used)." ] ;
    sh:property [
        sh:path [ sh:inversePath prov:wasGeneratedBy ] ; sh:minCount 1 ; sh:class codhmo:SearchDatabase ;
        sh:message "A database generation MUST produce a search database." ] .

shapes:SoftwareAgentShape a sh:NodeShape ;
    sh:targetClass prov:SoftwareAgent ;
    sh:property [
        sh:path dcterms:hasVersion ; sh:minCount 1 ;
        sh:message "Software MUST carry a version (dcterms:hasVersion)." ] .

# Taxon identifiers: numeric NCBI taxid IRIs only ---------------------------
shapes:NCBITaxonIdShape a sh:NodeShape ;
    sh:targetClass crminf:I4_Proposition_Set ;
    sh:sparql [
        sh:message "A biological-source proposition MUST use a numeric NCBI taxid IRI (http://purl.obolibrary.org/obo/NCBITaxon_<digits>), not a name." ;
        sh:prefixes [ sh:declare
            [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
            [ sh:prefix "codhmo" ; sh:namespace "https://codicum.eu/ontology/codhmo#"^^xsd:anyURI ] ] ;
        sh:select """
            SELECT $this ?value WHERE {
                $this rdf:predicate codhmo:hasBiologicalSource ; rdf:object ?value .
                FILTER (!isIRI(?value) || !REGEX(STR(?value), "^http://purl[.]obolibrary[.]org/obo/NCBITaxon_[0-9]+$"))
            }""" ] .

shapes:ComponentRoleValueShape a sh:NodeShape ;
    sh:targetClass crminf:I4_Proposition_Set ;
    sh:sparql [
        sh:message "A component-role proposition MUST use a role from codhmo:ComponentRoleScheme." ;
        sh:prefixes [ sh:declare
            [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
            [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
            [ sh:prefix "codhmo" ; sh:namespace "https://codicum.eu/ontology/codhmo#"^^xsd:anyURI ] ] ;
        sh:select """
            SELECT $this ?value WHERE {
                $this rdf:predicate codhmo:hasComponentRole ; rdf:object ?value .
                FILTER NOT EXISTS { ?value skos:inScheme codhmo:ComponentRoleScheme }
            }""" ] .

# Interpretive predicates are never asserted directly (D7, D18) -------------
shapes:NoAssertedInterpretationShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasComponentRole , codhmo:hasComponentMaterial ;
    sh:property [ sh:path codhmo:hasComponentRole ; sh:maxCount 0 ;
        sh:message "codhmo:hasComponentRole MUST NOT be asserted directly; state it inside a proposition." ] ;
    sh:property [ sh:path codhmo:hasComponentMaterial ; sh:maxCount 0 ;
        sh:message "codhmo:hasComponentMaterial MUST NOT be asserted directly; state it inside a proposition." ] .

# Human-derived material MUST be flagged (D21) --------------------------------
shapes:HumanDerivedSensitivityShape a sh:NodeShape ;
    sh:targetClass crminf:I4_Proposition_Set ;
    sh:sparql [
        sh:message "A proposition naming a Homo sapiens (NCBITaxon_9606) biological source MUST have its subject, and the belief holding it, flagged codhmo:sensitivity-human-derived." ;
        sh:prefixes [ sh:declare
            [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
            [ sh:prefix "crminf" ; sh:namespace "http://www.cidoc-crm.org/extensions/crminf/"^^xsd:anyURI ] ,
            [ sh:prefix "codhmo" ; sh:namespace "https://codicum.eu/ontology/codhmo#"^^xsd:anyURI ] ] ;
        sh:select """
            SELECT $this ?value WHERE {
                $this rdf:predicate codhmo:hasBiologicalSource ; rdf:object ?taxon ; rdf:subject ?material .
                FILTER (STR(?taxon) = "http://purl.obolibrary.org/obo/NCBITaxon_9606")
                ?belief crminf:J4_that $this .
                { BIND (?material AS ?value) } UNION { BIND (?belief AS ?value) }
                FILTER NOT EXISTS { ?value codhmo:hasSensitivity codhmo:sensitivity-human-derived }
            }""" ] .

# Former rdfs:domain/range, now reported instead of inferred (D22) ----------
shapes:CompetingHypothesisShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasCompetingHypothesis ;
    sh:targetObjectsOf codhmo:hasCompetingHypothesis ;
    sh:class crminf:I2_Belief ;
    sh:message "codhmo:hasCompetingHypothesis MUST link two crminf:I2_Belief nodes." .

shapes:ConfiguredStateSubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:configuredMaterialState ;
    sh:class codhmo:GenerationConfiguration ;
    sh:message "codhmo:configuredMaterialState MUST be stated on a GenerationConfiguration, never on a sample or material." .

shapes:PTMObservationLinkShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasPTMObservation ;
    sh:class codhmo:PeptideIdentification ;
    sh:property [ sh:path codhmo:hasPTMObservation ; sh:class codhmo:PTMObservation ;
        sh:message "codhmo:hasPTMObservation MUST point to a PTMObservation." ] ;
    sh:message "codhmo:hasPTMObservation MUST be stated on a PeptideIdentification." .

shapes:MaterialPropertySubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasMaterialState , codhmo:hasSourceTissue ;
    sh:or ( [ sh:class crmsci:S10_Material_Substantial ] [ sh:class crmsci:S13_Sample ] ) ;
    sh:message "codhmo:hasMaterialState / hasSourceTissue MUST be stated on a material body or sample." .

# 11. Source records (Step 7, D23) ------------------------------------------
shapes:SourceRecordSubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasSourceRecord ;
    sh:or ( [ sh:class crmsci:S4_Single_Observation ] [ sh:class codhmo:PeptideIdentification ] ) ;
    sh:property [ sh:path codhmo:hasSourceRecord ; sh:class codhmo:SourceRecord ;
        sh:message "codhmo:hasSourceRecord MUST point to a SourceRecord." ] ;
    sh:message "codhmo:hasSourceRecord MUST be stated on an observation or a peptide identification." .

shapes:SourceRecordShape a sh:NodeShape ;
    sh:targetClass codhmo:SourceRecord ;
    sh:property [ sh:path codhmo:inStore ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A source record MUST name exactly one store (codhmo:inStore)." ] ;
    sh:property [ sh:path codhmo:inTable ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "ZOOMS_SPECTRA" "MS2_SPECTRA" "MS1_ENVELOPE" ) ;
        sh:message "A source record MUST name exactly one known table (codhmo:inTable)." ] ;
    sh:property [ sh:path codhmo:storeSchemaVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A source record MUST record the store schema version it was written against." ] ;
    sh:property [ sh:path codhmo:hasKey ; sh:minCount 1 ;
        sh:message "A source record MUST carry at least one key (codhmo:hasKey)." ] ;
    sh:property [ sh:path [ sh:inversePath codhmo:hasSourceRecord ] ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:message "A source record SHOULD be referenced by an observation or peptide identification." ] ;
    sh:sparql [
        sh:message "A {?table} source record MUST carry key {?missing}." ;
        sh:select """
            PREFIX codhmo: <https://codicum.eu/ontology/codhmo#>
            SELECT $this ?table ?missing WHERE {
                $this codhmo:inTable ?table .
                # Required key columns per table (pyshacl forbids VALUES in constraints).
{ BIND("ZOOMS_SPECTRA" AS ?t) BIND("dataset_id" AS ?missing) }
                UNION { BIND("ZOOMS_SPECTRA" AS ?t) BIND("file_id" AS ?missing) }
                UNION { BIND("MS2_SPECTRA" AS ?t) BIND("dataset_id" AS ?missing) }
                UNION { BIND("MS2_SPECTRA" AS ?t) BIND("raw_filename" AS ?missing) }
                UNION { BIND("MS2_SPECTRA" AS ?t) BIND("scan_number" AS ?missing) }
                UNION { BIND("MS1_ENVELOPE" AS ?t) BIND("pxd_accession" AS ?missing) }
                UNION { BIND("MS1_ENVELOPE" AS ?t) BIND("file_id" AS ?missing) }
                UNION { BIND("MS1_ENVELOPE" AS ?t) BIND("ms2_title" AS ?missing) }
                FILTER (?t = ?table)
                FILTER NOT EXISTS { $this codhmo:hasKey ?k . ?k codhmo:keyName ?missing . }
            }""" ] ;
    sh:sparql [
        sh:message "A source record MUST NOT repeat key {?name}." ;
        sh:select """
            PREFIX codhmo: <https://codicum.eu/ontology/codhmo#>
            SELECT DISTINCT $this ?name WHERE {
                $this codhmo:hasKey ?k1 , ?k2 .
                ?k1 codhmo:keyName ?name . ?k2 codhmo:keyName ?name .
                FILTER (?k1 != ?k2)
            }""" ] .

shapes:SourceRecordKeyShape a sh:NodeShape ;
    sh:targetObjectsOf codhmo:hasKey ;
    sh:property [ sh:path codhmo:keyName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A source-record key MUST have exactly one string key name." ] ;
    sh:property [ sh:path codhmo:keyValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A source-record key MUST have exactly one string key value." ] .

# Taxonomic determinacy -----------------------------------------------------
shapes:DeterminacySubjectShape a sh:NodeShape ;
    sh:targetSubjectsOf crminf:J5_holds_to_be ;
    sh:class crminf:I2_Belief ;
    sh:message "crminf:J5_holds_to_be MUST be stated on a crminf:I2_Belief." .

shapes:DeterminacyValueShape a sh:NodeShape ;
    sh:targetObjectsOf crminf:J5_holds_to_be ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue codhmo:DeterminacyScheme ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A J5_holds_to_be value SHOULD come from codhmo:DeterminacyScheme. CRMinf permits other belief values; CODHMO expects its own scheme." ] .

shapes:TaxonomicHypothesisShape a sh:NodeShape ;
    sh:targetClass codhmo:TaxonomicHypothesis ;
    sh:property [
        sh:path crminf:J5_holds_to_be ;
        sh:maxCount 1 ;
        sh:message "A codhmo:TaxonomicHypothesis MUST carry at most one crminf:J5_holds_to_be: two determinacies for one attribution is incoherent." ] ;
    # NOTE: presence of crminf:J5_holds_to_be is deliberately NOT constrained here, at either
    # severity. The five examples predating codhmo:DeterminacyScheme carry no J5, and the
    # suite's minimal fixtures assert strict conformance, so even a sh:Warning would make every
    # bare TaxonomicHypothesis in the repo non-conformant. Determinacy is therefore required by
    # the Granzotti converter's own contract, not by this profile. Revisit once the pre-scheme
    # examples have been re-read against their sources and backfilled.
    sh:property [
        sh:path crminf:J4_that ;
        sh:minCount 1 ;
        sh:message "A codhmo:TaxonomicHypothesis MUST state its proposition with crminf:J4_that." ] .

# codhmo:indistinguishable reports that the method cannot separate its members; the source is
# not undecided between them. Marking them competing would assert a disagreement the source
# never expressed, so it is a violation rather than a warning.
shapes:IndistinguishableNotCompetingShape a sh:NodeShape ;
    sh:targetSubjectsOf codhmo:hasCompetingHypothesis ;
    sh:not [
        sh:property [
            sh:path crminf:J5_holds_to_be ;
            sh:hasValue codhmo:indistinguishable ;
            sh:minCount 1 ] ] ;
    sh:message "A belief held as codhmo:indistinguishable MUST NOT carry codhmo:hasCompetingHypothesis: its members are an irreducible set, not rival hypotheses." .
